{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile document containing account settings and identity info",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "Chat": {
      "title": "Chat",
      "description": "User chat thread metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "model": { "type": "string", "maxLength": 64 },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message in a conversation thread",
      "type": "object",
      "properties": {
        "chatId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant", "system"] },
        "content": { "type": "string", "maxLength": 100000 },
        "createdAt": { "type": "string" }
      },
      "required": ["chatId", "userId", "role", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profile data accessible only by the owner"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "Chat" },
      "description": "Chat conversations belonging to the user"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Messages belonging to a chat conversation"
    }
  }
}
